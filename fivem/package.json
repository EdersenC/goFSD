{
  "name": "fsd",
  "version": "1.0.0",
  "description": "FiveM temporal stop-sign dataset collection resource",
  "scripts": {
    "build": "esbuild src/client.ts --bundle --platform=browser --format=iife --target=es2017 --outfile=dist/client.js && esbuild src/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/server.js",
    "build:deploy": "node scripts/build-deploy.mjs",
    "deploy:check": "node scripts/build-deploy.mjs --dry-run",
    "build:wsl": "npm run build:deploy",
    "watch": "sh -c 'esbuild src/client.ts --bundle --platform=browser --format=iife --target=es2017 --outfile=dist/client.js --watch=forever & esbuild src/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/server.js --watch=forever & wait'",
    "watch:deploy": "node scripts/build-deploy.mjs --watch",
    "watch:wsl": "npm run watch:deploy",
    "typecheck": "tsc --noEmit",
    "test:world-isolation": "esbuild src/world-isolation.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/world-isolation.test.cjs && node dist/tests/world-isolation.test.cjs",
    "test:control-safety": "esbuild src/control-safety.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/control-safety.test.cjs && node dist/tests/control-safety.test.cjs",
    "test:control-dispatch": "esbuild src/control-dispatch.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/control-dispatch.test.cjs && node dist/tests/control-dispatch.test.cjs",
    "test:control-session": "esbuild src/control-session-frontier.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/control-session-frontier.test.cjs && node dist/tests/control-session-frontier.test.cjs",
    "test:scene-completion": "esbuild src/scene-completion.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/scene-completion.test.cjs && node dist/tests/scene-completion.test.cjs",
    "test:player-setup": "esbuild src/player-setup.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/player-setup.test.cjs && node dist/tests/player-setup.test.cjs",
    "test:waypoint-teleport": "esbuild src/waypoint-teleport.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/waypoint-teleport.test.cjs && node dist/tests/waypoint-teleport.test.cjs",
    "test:stop-sign-catalog": "esbuild src/stop-sign/catalog-waypoint.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/stop-sign-catalog.test.cjs && node dist/tests/stop-sign-catalog.test.cjs",
    "test:stop-sign-probe": "esbuild src/stop-sign/location-probe.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/stop-sign-probe.test.cjs && node dist/tests/stop-sign-probe.test.cjs",
    "test:stop-sign": "esbuild src/stop-sign/stop-sign.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/stop-sign.test.cjs && node dist/tests/stop-sign.test.cjs",
    "test": "npm run test:world-isolation && npm run test:control-safety && npm run test:control-dispatch && npm run test:control-session && npm run test:scene-completion && npm run test:player-setup && npm run test:waypoint-teleport && npm run test:stop-sign-catalog && npm run test:stop-sign-probe && npm run test:stop-sign",
    "clean": "rm -rf dist",
    "clean:wsl": "npm run clean"
  },
  "type": "module",
  "devDependencies": {
    "@citizenfx/client": "^2.0.25963-1",
    "@citizenfx/server": "^2.0.25963-1",
    "@types/node-fetch": "^2.6.13",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
