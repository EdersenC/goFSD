{
  "name": "fsd",
  "version": "1.0.0",
  "description": "FiveM parking and driving dataset collection resource",
  "scripts": {
    "build": "esbuild src/client.ts --bundle --platform=browser --format=iife --target=es2017 --outfile=dist/client.js && esbuild src/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/server.js",
    "build:deploy": "node scripts/build-deploy.mjs",
    "deploy:check": "node scripts/build-deploy.mjs --dry-run",
    "build:wsl": "npm run build:deploy",
    "watch": "sh -c 'esbuild src/client.ts --bundle --platform=browser --format=iife --target=es2017 --outfile=dist/client.js --watch=forever & esbuild src/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/server.js --watch=forever & wait'",
    "watch:deploy": "node scripts/build-deploy.mjs --watch",
    "watch:wsl": "npm run watch:deploy",
    "typecheck": "tsc --noEmit",
    "test:parking": "esbuild src/parking/parking.test.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/tests/parking.test.cjs && node dist/tests/parking.test.cjs",
    "test": "npm run test:parking",
    "clean": "rm -rf dist",
    "clean:wsl": "npm run clean"
  },
  "type": "module",
  "devDependencies": {
    "@citizenfx/client": "^2.0.25963-1",
    "@citizenfx/server": "^2.0.25963-1",
    "@types/node-fetch": "^2.6.13",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
